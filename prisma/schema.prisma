generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectType {
  WEB
  MOBILE
  SAAS
  GAME
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  FREELANCE
  CONTRACT
}

enum TeamWorkType {
  SOLO
  TEAM
}

enum ResponsibilityLevel {
  LEAD
  CORE
  SUPPORT
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model Profile {
  id           String  @id @default("PROFILE_SINGLETON")
  fullName     String
  headline     String
  bio          String?
  avatarUrl    String?
  avatarKey    String?
  resumeUrl    String?
  resumeKey    String?
  location     String?
  availability String?

  socials SocialLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String  @id @default(cuid())
  label     String?
  url       String
  order     Int     @default(0)
  isPrimary Boolean @default(false)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, url])
  @@index([profileId, order])
}

model SkillCategory {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  skills Skill[]
}

model Skill {
  id   String @id @default(cuid())
  name String

  yearsOfExperience Int?
  level             SkillLevel?

  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  order Int @default(0)

  projects ProjectSkill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id String @id @default(cuid())

  title       String
  summary     String?
  description String?

  images String[]

  projectType ProjectType

  liveUrl   String?
  githubUrl String?

  isFeatured Boolean @default(false)
  order      Int     @default(0)

  skills ProjectSkill[]

  experienceProjects ExperienceProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectSkill {
  projectId String
  skillId   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
}

model Experience {
  id String @id @default(cuid())

  company    String
  role       String
  employment EmploymentType

  responsibilities String
  achievements     String?

  teamworkType   TeamWorkType
  teamSize       Int?
  responsibility ResponsibilityLevel

  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean   @default(false)

  logoUrl String?
  order   Int     @default(0)

  experienceProjects ExperienceProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExperienceProject {
  experienceId String
  projectId    String

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([experienceId, projectId])
}

model Education {
  id String @id @default(cuid())

  institution String
  degree      String?
  field       String?

  startYear DateTime?
  endYear   DateTime?

  logoUrl     String?
  description String?

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
